# ==============================================================================
# Supabase Configuration
# ==============================================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ==============================================================================
# AI / LLM Keys
# ==============================================================================
GEMINI_API_KEY=your-google-gemini-api-key
OPENAI_API_KEY=your-openai-api-key          # optional fallback

# ==============================================================================
# Identity Verification / KYC Gateway
# ==============================================================================
KYC_GATEWAY_URL=                              # e.g., https://sandbox.setu.co
KYC_GATEWAY_API_KEY=                          # API key for Setu/Cashfree sandbox
FACE_MATCH_THRESHOLD=0.40                     # cosine distance threshold (0.40 ≈ 90% confidence)
FACE_MATCH_MODEL=VGG-Face                     # DeepFace model: VGG-Face | Facenet512 | ArcFace

# ==============================================================================
# Application
# ==============================================================================
APP_ENV=development           # development | production
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
