  "01e28347d2": "ஆண்டு/அரை ஆண்டு/காலாண்டு/மாதாந்திர பிரீமியம்",
  "c7f95298bb": "அடையாளச் சான்று",
  "9b2af23f23": "முகவரி ஆதாரம்",
  "145a3996bd": "வருமானச் சான்று",
  "4c1fa6f6eb": "மருத்துவ அறிக்கைகள்",
  "5682af7e44": "LIC கிளை / முகவர்கள் / ஆன்லைன்",
  "632637cb98": "குடும்பப் பாதுகாப்பை உறுதி செய்யும் அதே வேளையில் ஓய்வூதியக் கார்பஸ் கட்ட விரும்பும் நெசவாளர்களுக்குப் பரிந்துரைக்கப்படுகிறது.",
  "99e1da6be7": "ஸ்டார் ஹெல்த் விரிவான திட்டம்",
  "e21ee1798d": "நட்சத்திர ஆரோக்கியம்",
  "4f1adf9e10": "₹3,00,000 - ₹25,00,000",
  "e6861075fc": "விரிவான உள்நோயாளி பாதுகாப்பு",
  "c425d4a179": "பகல்நேர பராமரிப்பு நடைமுறைகள் சேர்க்கப்பட்டுள்ளன",
  "b6b0c864a3": "பெரும்பாலான சிகிச்சைகளுக்கு இணை கட்டணம் இல்லை",
  "25fdbd863a": "முழு பயன்பாட்டில் மறுசீரமைப்பு நன்மை",
  "e1520d2c37": "குடும்ப மிதவை அல்லது தனிப்பட்ட திட்டம்",
  "512b73d775": "ஸ்டார் ஹெல்த் ஹெல்ப்லைனை அழைக்கவும்",
  "ac1b4d4a63": "4 மணி நேரத்திற்குள் முன் அங்கீகாரத்தைப் பெறுங்கள்",
  "cd05b28b57": "பணமில்லா அல்லது திருப்பிச் செலுத்துதல்",
  "1d088b9811": "ஆன்லைனில் சமர்ப்பிக்கப்பட்ட ஆவணங்கள்",
  "c881bc5f5d": "தனியார் துறை",
  "86d709fb9e": "உங்களுக்கும் உங்கள் குடும்பத்துக்கும் விரிவான சுகாதார பாதுகாப்பு.",
  "52a4c3be8d": "விரிவான மருத்துவ பாதுகாப்பு தேவைப்படும் குடும்பங்கள்",
  "7a61fa946a": "சுகாதார அறிவிப்பு",
  "2772355ba0": "ஸ்டார் ஹெல்த் இணையதளம் / முகவர்கள்",
  "fcc546f490": "எதிர்பாராத மருத்துவமனை செலவுகள் மற்றும் மருத்துவ அவசரநிலைகளில் இருந்து குடும்பத்தைப் பாதுகாக்கிறது.",
  "89381fa2ff": "தேசிய தறி மற்றும் நூல் காப்பீடு",
  "e6bca5cab1": "தேசிய காப்பீட்டு நிறுவனம்",
  "5f4aa6e285": "தறிக்கு ₹2,00,000; நூலுக்கு ₹50,000",
  "8338cfd7cf": "தீ, திருட்டு மற்றும் இயற்கை பேரழிவுகளுக்கு எதிரான பாதுகாப்பு",
  "b0b97620a3": "போக்குவரத்தில் உள்ள நூல் மற்றும் முடிக்கப்பட்ட பொருட்கள் மூடப்பட்டிருக்கும்",
  "27025db18e": "உரிமைகோரலுக்கான குறைந்தபட்ச ஆவணங்கள்",
  "bc0a559309": "விரைவு சர்வேயர் அனுப்புதல்",
  "379ba7890f": "பதிவு செய்யப்பட்ட நெசவாளர்",
  "ba757bf4ad": "குறைந்தபட்சம் ஒரு கைத்தறியின் உரிமை",
  "bcedb19100": "திருட்டு/தீ விபத்து ஏற்பட்டால் FIR பதிவு செய்யவும்",
  "5d3d5f7345": "காப்பீட்டு நிறுவனத்திற்கு 48 மணி நேரத்திற்குள் தெரிவிக்கவும்",
  "2c280c9505": "சர்வேயர் இடத்தை பார்வையிடுகிறார்",
