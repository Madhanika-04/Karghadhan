  "3ca2513aaa": "நெசவுடன் தொடர்புடைய தொழில் விபத்து அபாயங்கள் காரணமாக அனைத்து செயலில் உள்ள நெசவாளர்களுக்கும் கடுமையாக பரிந்துரைக்கப்படுகிறது.",
  "01c5423eda": "ஆயுஷ்மான் பாரத் - PM-JAY",
  "9d5fd38b51": "தேசிய சுகாதார ஆணையம்",
  "3b6647ed73": "ஒரு குடும்பத்திற்கு ஆண்டுக்கு ₹5,00,000 சுகாதார காப்பீடு",
  "7404c62021": "1,929 மருத்துவ நடைமுறைகளை உள்ளடக்கியது",
  "c64e9cf0b3": "எம்பேனல் செய்யப்பட்ட மருத்துவமனைகளில் பணமில்லா சிகிச்சை",
  "102989ff28": "மருத்துவமனைக்குச் செல்லும் முன் மற்றும் பின் செலவுகள்",
  "ac691e216d": "SECC 2011 தரவுகளின் கீழ் அடையாளம் காணப்பட்டது",
  "182a5cbf19": "ஆதாருடன் நெசவாளர்கள் மற்றும் கைவினைஞர்கள்",
  "ae6256b6b7": "அறிவிக்கப்பட்ட தொழில்களுக்கு வருமான வரம்பு இல்லை",
  "402a059a0d": "எம்பேனல் செய்யப்பட்ட மருத்துவமனையைப் பார்வையிடவும்",
  "1b27644bbf": "ஆயுஷ்மான் அட்டை / ஆதாரை காட்டு",
  "d137ef1d10": "பணமில்லா சிகிச்சை தொடங்கப்பட்டது",
  "5603a4b025": "மருத்துவமனை கோப்புகள் நேரடியாக உரிமை கோருகின்றன",
  "d99703a7a3": "சுகாதார காப்பீடு",
  "8b78abd55b": "ரொக்கமில்லா மருத்துவமனையில் அனுமதிக்கப்படும் தேசிய சுகாதார பாதுகாப்பு திட்டம்.",
  "402cd4fe9a": "தகுதியான BPL குடும்பங்கள் மற்றும் அறிவிக்கப்பட்ட கைவினைஞர்கள்",
  "cc1a252ae1": "1 வருடம்",
  "c4c696d78d": "ஆண்டு",
  "76dcc91fbe": "ரேஷன் கார்டு",
  "c71dec38be": "PM-JAY ஐடி / கோல்டன் கார்டு",
