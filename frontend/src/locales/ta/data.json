  "b9a6afafd4": "அறுவை சிகிச்சைகள்",
  "6ca1e65cba": "விபத்து சிகிச்சைகள்",
  "74a437a63f": "மருத்துவமனைச் செலவுகளிலிருந்து குடும்பத்தைப் பாதுகாக்கிறது.",
  "81338a4c60": "தனிப்பட்ட விபத்து காப்பீடு",
  "386b25de7a": "ஒவ்வொரு செயலில் உள்ள நெசவாளர்",
  "0f115b52eb": "விபத்து மரணத்திற்கான பாதுகாப்பு",
  "dadc431167": "நிரந்தர/பகுதி ஊனம் காப்பீடு",
  "f9eab08347": "வருமான மாற்று",
  "4de8fa938d": "பணியிட விபத்துக்கள்",
  "5bf91ffbd3": "சாலை விபத்துகள்",
  "9ab15f2b55": "சுறுசுறுப்பான நெசவாளர்களுக்கு அத்தியாவசிய விபத்து பாதுகாப்பு.",
  "817078f804": "கடன் பாதுகாப்பு காப்பீடு",
  "b7cdc90fec": "ஏற்கனவே உள்ள கடன்களுடன் நெசவாளர்கள்",
  "5c13aae63c": "இறப்பு/இயலாமை ஏற்பட்டால் நிலுவையில் உள்ள கடன் EMI-ஐ உள்ளடக்கியது",
  "2dd9a6a194": "குடும்பச் சுமையைத் தடுக்கிறது",
  "d42f8077fa": "கடன் வாங்கியவரின் மரணம்",
  "0f3b6efb19": "நிரந்தர இயலாமை",
  "203d28eb5e": "பயனரிடம் செயலில் கடன் இருப்பதால் பரிந்துரைக்கப்படுகிறது.",
  "8d5d4b8d82": "தறிகள் மற்றும் இயந்திரங்களுக்கான பாதுகாப்பு",
  "898d1421f7": "திருட்டு மற்றும் சேதத்திற்கு எதிரான பாதுகாப்பு",
  "8197819d8a": "தறி முறிவு",
  "c361480a3b": "உபகரணங்கள் திருட்டு",
  "c1829e67ef": "உங்கள் முதன்மையான வர்த்தகக் கருவிகளைப் பாதுகாப்பதில் முக்கியமானது.",
  "85ed750e52": "பட்டறை உரிமையாளர்கள்",
  "d5d754ca4f": "தீ மற்றும் இயற்கை ஆபத்துகளுக்கு எதிரான பாதுகாப்பு",
  "34b43f48af": "கட்டிடம் மற்றும் உள்ளடக்கங்களை உள்ளடக்கியது",
  "6c3ee41365": "தீ விபத்துகள்",
  "92eed500e9": "மின்னல் சேதம்",
  "7047b2bfc8": "தீ அபாயங்களிலிருந்து உங்கள் பட்டறை மற்றும் மதிப்புமிக்க சரக்குகளைப் பாதுகாக்கிறது.",
  "1ecda0c7d4": "கொள்ளை காப்பீடு",
  "0178de4b00": "பங்கு உரிமையாளர்கள்",
  "c4466411ae": "திருட்டு காரணமாக இருப்பு/நூல் இழப்பை ஈடுசெய்யும்",
  "9e40d2c0a0": "உடைப்பு போது வளாகத்திற்கு சேதம்",
  "04d9f58df0": "முடிக்கப்பட்ட பட்டு/பருத்தி திருட்டு",
  "9231962665": "உபகரணங்கள் திருட்டு",
  "6ae68e988f": "குறிப்பிடத்தக்க மூலப்பொருள் அல்லது முடிக்கப்பட்ட இருப்பு வைத்திருக்கும் நெசவாளர்களுக்கு பரிந்துரைக்கப்படுகிறது.",
  "77400aea04": "மூலப்பொருள் வழங்கல் திட்டம்",
  "2f6ab504e6": "நெசவாளர்களுக்கு நூல், சாயம், ரசாயனம் போன்ற உயர்தர மூலப்பொருட்களை மானிய விலையில் கூட்டுறவு சங்கங்கள் மூலம் கொள்முதல் செய்ய அரசு திட்டம்.",
  "2b18029087": "30-50% மானிய விலையில் தரமான நூல்",
  "be39b99b1a": "ஆலைகளில் இருந்து நெசவாளர்களுக்கு விநியோகச் சங்கிலியை ஒழுங்கமைத்தது",
  "2b320a14de": "உற்பத்தி செலவில் குறைப்பு",
  "2838257c98": "ஆண்டு முழுவதும் பொருள் கிடைக்கும் உறுதி",
  "5fdc4b1bcc": "நெசவாளர் அடையாளத்துடன் பதிவுசெய்யப்பட்ட கைத்தறி நெசவாளர்",
  "694cd49a50": "பதிவு செய்யப்பட்ட கைத்தறி கூட்டுறவு சங்கத்தின் உறுப்பினர்",
  "124fe5cdd6": "இதேபோன்ற திட்டத்தை வேறொரு துறையிலிருந்து பெறவில்லை",
  "0aea9e22c2": "கூட்டுறவு உறுப்பினர் சான்று",
  "3b43889f27": "வங்கி பாஸ்புக்",
  "a52ecba24e": "மானியங்கள்",
  "89973762dd": "ஜவுளி அமைச்சகம்",
  "15ad4bad4b": "நூல் மானியத் திட்டம்",
  "83527cab78": "பருத்தி, பட்டு மற்றும் கம்பளி நூல் வாங்குவதற்கு கைத்தறி நெசவாளர்களுக்கு நேரடி பண மானியம், உள்ளீடு செலவைக் குறைத்தல் மற்றும் பாரம்பரிய ஜவுளி உற்பத்தியை ஆதரிக்கிறது.",
  "893909fdd3": "ஆண்டுக்கு ₹4,000–₹12,000 நேரடி பலன் பரிமாற்றம்",
  "0acd6c55fc": "பருத்தி, பட்டு மற்றும் கம்பளி நூல் ஆகியவற்றை உள்ளடக்கியது",
  "a36c494b58": "விசைத்தறி மற்றும் கைத்தறி ஆகிய இரண்டிற்கும் பொருந்தும்",
  "aefd9ad366": "சிறு நெசவாளர்களுக்கு அளவு மேல் வரம்பு இல்லை",
  "1599ae9b3b": "மாநில அரசால் வழங்கப்பட்ட செல்லுபடியாகும் நெசவாளர் அடையாள அட்டை",
  "f2400b302d": "ஆண்டு வருமானம் ₹1.5 லட்சத்துக்கும் குறைவாக",
  "a72eabb3a0": "வழக்கமான அரசுப் பணியில் அமர்த்தப்படவில்லை",
  "6d8a7f0571": "வருமானச் சான்றிதழ்",
  "0e67989f1b": "வங்கி கணக்கு விவரங்கள்",
  "6e65424869": "சூரிய விசைத்தறி திட்டம்",
  "d7543a5614": "நெசவாளர்களுக்கு மின்சாரம் சார்ந்திருப்பதைக் குறைப்பதற்கும், நிலையான உற்பத்தியை ஆதரிப்பதற்கும், இயக்கச் செலவுகளை 60% வரை குறைப்பதற்கும் சூரிய சக்தியில் இயங்கும் தறி அமைப்புகளை வழங்குகிறது.",
  "4e4cbdae7f": "சோலார் தறி நிறுவலுக்கு 90% மானியம்",
  "e840ff121f": "மின்சார செலவு 60% குறைப்பு",
  "dd891bf7bf": "தயாரிப்புகளுக்கு பச்சை சான்றிதழ்",
  "0c8922b229": "அரசு கொள்முதல் ஆணைகளில் முன்னுரிமை",
  "759c863dfd": "குறைந்தபட்சம் 3 வருட அனுபவம் கொண்ட பதிவு செய்யப்பட்ட நெசவாளர்",
  "5be5efb71d": "சொந்தமாக அல்லது குத்தகைக்கு நெசவு இடம்",
  "8ea1a7178a": "இதற்கு முன்பு சோலார் கருவி மானியம் பெறப்படவில்லை",
  "4bff82a5f2": "நெசவு இட உரிமை/குத்தகைக்கான சான்று",
  "ab2430633e": "பாஸ்போர்ட் புகைப்படம்",
  "0d08974539": "புதிய மற்றும் புதுப்பிக்கத்தக்க எரிசக்தி அமைச்சகம்",
  "0b887c236c": "தேசிய கைத்தறி மேம்பாட்டுத் திட்டம்",
  "58ce32e9b9": "உள்கட்டமைப்பு, திறன் பயிற்சி, வடிவமைப்பு மேம்பாடு மற்றும் சந்தை அணுகல் உள்ளிட்ட கைத்தறித் துறையின் விரிவான வளர்ச்சிக்கான முதன்மையான அரசுத் திட்டம்.",
  "acd0638491": "நெசவு கொத்துக்களுக்கான உள்கட்டமைப்பு ஆதரவு",
  "6aeaf581a0": "வடிவமைப்பு மேம்பாடு மற்றும் பயிற்சி உதவித்தொகை",
  "6bf3a2ca19": "தேசிய மற்றும் சர்வதேச கண்காட்சிகளில் சந்தை வெளிப்பாடு",
  "4adf4c6f13": "பிராண்ட் கட்டிடம் மற்றும் தயாரிப்பு சான்றிதழ்",
  "8d39d2a7ad": "தனிப்பட்ட நெசவாளர் அல்லது நெசவாளர் குழு",
  "b10b3d4ceb": "நியமிக்கப்பட்ட கைத்தறி கிளஸ்டரில் அமைந்துள்ளது",
  "1a9a6d8868": "மாவட்ட கைத்தறி அலுவலகத்தில் செல்லுபடியாகும் பதிவு",
  "7d963a7c3f": "மாவட்ட கைத்தறி அலுவலகத்தில் பதிவு சான்றிதழ்",
  "875ec24cf2": "கிளஸ்டர் ஐடி ஆதாரம்",
  "f1b3e6404a": "வங்கி விவரங்கள்",
  "cf270e40d2": "பயிற்சி",
  "e9cbaede0a": "கைத்தறி நெசவாளர்களுக்கான திறன் மேம்பாட்டுத் திட்டம்",
  "2b692b685b": "நெசவாளர் சேவை மையங்களின் கீழ், நெசவுத் திறனை மேம்படுத்தவும், புதிய வடிவமைப்புகள், நவீன தொழில் நுட்பங்கள் மற்றும் உள்நாட்டு மற்றும் ஏற்றுமதி சந்தைகளுக்கான தரத் தரங்களை அறிமுகப்படுத்தவும் பயிற்சித் திட்டம்.",
  "b8b9e2b350": "இலவச 3-6 மாத பயிற்சி திட்டம்",
  "a9415e7c4e": "பயிற்சியின் போது மாதாந்திர உதவித்தொகை ₹3,000",
  "da63e0bd58": "வடிவமைப்பு போர்ட்ஃபோலியோ உருவாக்கம்",
  "4f2868f5fb": "அரசு சான்றளிக்கப்பட்ட திறன் சான்றிதழ்",
  "e0ff9f8026": "வேலை வாய்ப்பு உதவி",
  "a5987033da": "வயது 18-45 வயது",
  "be9eed8f23": "பதிவு செய்யப்பட்ட நெசவாளர் அல்லது நெசவாளர் குடும்ப உறுப்பினர்",
  "f449c15783": "குறைந்த பட்சம் ஐந்தாம் வகுப்பு படித்திருக்க வேண்டும்",
  "9d5f37d716": "நெசவாளர் ஐடி அல்லது குடும்ப நெசவாளர் சான்றிதழ்",
  "96ece2fa9e": "கல்வித் தகுதிச் சான்று",
  "9c2d22a619": "ஜவுளி அமைச்சகம் / NSDC",
  "c7a3db139c": "புத்திசாலித்தனமான பணத்தைச் சேமிப்பது",
  "65b35899ee": "பருவகால வருவாய் முறைகளுடன் நெசவாளர்களுக்காக வடிவமைக்கப்பட்ட நடைமுறை சேமிப்பு உத்திகளைக் கற்றுக்கொள்ளுங்கள்.",
  "ab0da0e987": "சேமிப்பு",
  "2ddabc33a6": "ஆரம்பநிலை",
  "68a4c28f94": "சேமிப்பு இலக்குகளை அமைத்தல்",
  "4f791417c9": "தொடர் வைப்புத்தொகை",
  "0c364714ab": "தபால் அலுவலக திட்டங்கள்",
  "588b9cd7b7": "அவசர நிதி",
  "9225e287d4": "மரகதம்-500 முதல் டீல்-600 வரை",
  "60b09570e6": "காப்பீட்டு அடிப்படைகள்",
  "7136cae533": "இன்சூரன்ஸ் ஏன் முக்கியமானது மற்றும் எந்த பாலிசிகள் குறைந்த செலவில் உங்களுக்கு அதிகபட்ச பாதுகாப்பை வழங்குகின்றன என்பதைப் புரிந்து கொள்ளுங்கள்.",
  "eaff1bdf24": "காப்பீடு",
  "0716bc4f1a": "🛡️",
  "6b7307dea9": "காப்பீடு என்றால் என்ன?",
  "aac3e4ec65": "ஆயுள் vs சுகாதார காப்பீடு",
  "f9a2d645f2": "PMJJBY & PMSBY",
  "f9a3b7d078": "எப்படி உரிமை கோருவது",
  "5379bc905a": "நீலம்-500 முதல் இண்டிகோ-600 வரை",
  "aeb3c58be0": "கடன்களைப் புரிந்துகொள்வது",
  "35da00f929": "நல்ல கடனுக்கும் கெட்ட கடனுக்கும் உள்ள வித்தியாசத்தையும், சரியான கடன் திட்டத்தை எவ்வாறு தேர்வு செய்வது என்பதையும் அறிந்து கொள்ளுங்கள்.",
  "64e109fb6d": "கடன்கள்",
  "d2e86e8ca6": "கடன்களின் வகைகள்",
  "a7a506bec1": "வட்டி விகிதங்கள் விளக்கப்பட்டுள்ளன",
  "f25631f656": "EMI கால்குலேட்டர்",
  "d1a9a1e112": "எப்படி விண்ணப்பிக்க வேண்டும்",
  "f9fde551df": "ஊதா-500 முதல் ஊதா-600 வரை",
  "5bbd50878b": "உங்கள் கிரெடிட் ஸ்கோர்",
  "60ba5dd65c": "சிறந்த கடன் விதிமுறைகள் மற்றும் நிதி தயாரிப்புகளைத் திறக்க வலுவான கிரெடிட் ஸ்கோரை உருவாக்கி பராமரிக்கவும்.",
  "ae61b052c4": "கிரெடிட் ஸ்கோர்",
  "b57ed7a0b4": "இடைநிலை",
  "9dac22807a": "CIBIL என்றால் என்ன?",
  "b189f8955c": "மதிப்பெண்கள் எவ்வாறு கணக்கிடப்படுகின்றன",
  "d19bc7dc0e": "உங்கள் மதிப்பெண்ணை மேம்படுத்துகிறது",
  "e573304ed3": "கடன் அறிக்கை வாசிப்பு",
  "1d2c37ec91": "ஆம்பர்-500 முதல் ஆரஞ்சு-600 வரை",
  "f1624dc1ba": "டிஜிட்டல் கொடுப்பனவுகள்",
  "4130eddfc2": "நம்பிக்கையுடன் பணமில்லா செல்லுங்கள் - மொபைல் பேங்கிங் மற்றும் டிஜிட்டல் வாலட்களை எவ்வாறு பாதுகாப்பாகப் பயன்படுத்துவது என்பதை அறியவும்.",
  "f27cd95282": "இணைய வங்கி அடிப்படைகள்",
  "5dfad11e2f": "டெபிட் கார்டு பாதுகாப்பு",
  "acb3930480": "மொபைல் பணப்பைகள்",
  "3d25e73cde": "ஆன்லைன் பரிவர்த்தனைகள்",
  "f36aa33aa5": "சியான்-500 முதல் நீலம்-600 வரை",
  "973213f432": "UPI - ஒருங்கிணைந்த கட்டண இடைமுகம்",
  "ab1be076a0": "உடனடி, இலவச பணப் பரிமாற்றங்களுக்கான முதன்மை UPI. வணிக பரிவர்த்தனைகளுக்கு மீண்டும் ஒருபோதும் பணத்தை எடுத்துச் செல்ல வேண்டாம்.",
  "dae75ed3b2": "UPI",
  "f581499ca2": "UPI ஐ அமைக்கிறது",
  "395ab5f946": "UPI ஐடி உருவாக்கம்",
  "e6b04e3aae": "பணம் அனுப்புதல் மற்றும் பெறுதல்",
  "56f5d297ef": "வணிகத்திற்கான UPI",
  "bb591540bb": "பச்சை-500 முதல் மரகதம்-600 வரை",
  "0b2e3a557f": "கடன் மோசடியைத் தவிர்க்கவும்",
  "d9999a6537": "நேர்மையற்ற பணம் கொடுப்பவர்கள் மற்றும் கிராமப்புற சமூகங்களை இலக்காகக் கொண்ட டிஜிட்டல் லோன் ஆப் மோசடிகளில் இருந்து உங்களைப் பாதுகாத்துக் கொள்ளுங்கள்.",
  "2827e3890f": "மோசடி விழிப்புணர்வு",
  "45ce33bd18": "மோசடி அறிகுறிகள்",
  "6e1b2c978b": "போலி கடன் பயன்பாடுகள்",
  "7e7397a7b7": "தரவு பாதுகாப்பு",
  "6c26a3cfb9": "எங்கே புகார் செய்வது",
  "d14f8a93c1": "சிவப்பு-500 முதல் ரோஜா-600 வரை",
  "7d11418018": "முதலீட்டு அடிப்படைகள்",
  "df74a6ede2": "பாதுகாப்பான மற்றும் நம்பகமான முதலீட்டு விருப்பங்கள் மூலம் உங்கள் செல்வத்தை எவ்வாறு வளர்ப்பது என்பதை அறிக.",
  "5ac4a570fc": "பரஸ்பர நிதிகள்",
  "b3f32a042f": "நிலையான வைப்பு",
  "4b1697760a": "தங்க முதலீடுகள்",
  "daf4f60f18": "பங்குச் சந்தை அடிப்படைகள்",
