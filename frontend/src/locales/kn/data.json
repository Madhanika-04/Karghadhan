  "f452e524b9": "ಪ್ರತಿಯೊಬ್ಬ ನೇಕಾರ ಮತ್ತು ಕುಟುಂಬ",
  "78886f1cb1": "ನಗದುರಹಿತ ಆಸ್ಪತ್ರೆಗೆ",
  "090a222c76": "ಆಸ್ಪತ್ರೆಗೆ ದಾಖಲಾಗುವ ಪೂರ್ವ ಮತ್ತು ನಂತರದ ಕವರ್",
  "b1fb74c67c": "ಗಂಭೀರ ಅನಾರೋಗ್ಯದ ಕವರ್",
  "18cae0d8b7": "ವೈದ್ಯಕೀಯ ತುರ್ತುಸ್ಥಿತಿಗಳು",
