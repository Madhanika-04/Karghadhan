  "5c13aae63c": "ಸಾವು/ಅಂಗವೈಕಲ್ಯದ ಸಂದರ್ಭದಲ್ಲಿ ಬಾಕಿ ಇರುವ ಸಾಲದ EMI ಅನ್ನು ಒಳಗೊಂಡಿದೆ",
  "2dd9a6a194": "ಕುಟುಂಬದ ಹೊರೆಯನ್ನು ತಡೆಯುತ್ತದೆ",
  "d42f8077fa": "ಸಾಲಗಾರನ ಸಾವು",
  "0f3b6efb19": "ಶಾಶ್ವತ ಅಂಗವೈಕಲ್ಯ",
  "203d28eb5e": "ಬಳಕೆದಾರರು ಸಕ್ರಿಯ ಸಾಲವನ್ನು ಹೊಂದಿರುವ ಕಾರಣ ಶಿಫಾರಸು ಮಾಡಲಾಗಿದೆ.",
  "8d5d4b8d82": "ಮಗ್ಗಗಳು ಮತ್ತು ಯಂತ್ರೋಪಕರಣಗಳಿಗೆ ರಕ್ಷಣೆ",
  "898d1421f7": "ಕಳ್ಳತನ ಮತ್ತು ಹಾನಿಯ ವಿರುದ್ಧ ರಕ್ಷಣೆ",
  "8197819d8a": "ಮಗ್ಗ ಸ್ಥಗಿತ",
  "c361480a3b": "ಸಲಕರಣೆಗಳ ಕಳ್ಳತನ",
  "c1829e67ef": "ವ್ಯಾಪಾರದ ನಿಮ್ಮ ಪ್ರಾಥಮಿಕ ಸಾಧನಗಳನ್ನು ರಕ್ಷಿಸಲು ನಿರ್ಣಾಯಕವಾಗಿದೆ.",
  "85ed750e52": "ಕಾರ್ಯಾಗಾರದ ಮಾಲೀಕರು",
  "d5d754ca4f": "ಬೆಂಕಿ ಮತ್ತು ನೈಸರ್ಗಿಕ ಅಪಾಯಗಳ ವಿರುದ್ಧ ರಕ್ಷಣೆ",
  "34b43f48af": "ಕಟ್ಟಡ ಮತ್ತು ವಿಷಯಗಳನ್ನು ಒಳಗೊಂಡಿದೆ",
  "6c3ee41365": "ಅಗ್ನಿ ಅವಘಡಗಳು",
  "92eed500e9": "ಮಿಂಚಿನ ಹಾನಿ",
  "7047b2bfc8": "ಬೆಂಕಿಯ ಅಪಾಯಗಳಿಂದ ನಿಮ್ಮ ಕಾರ್ಯಾಗಾರ ಮತ್ತು ಬೆಲೆಬಾಳುವ ದಾಸ್ತಾನುಗಳನ್ನು ರಕ್ಷಿಸುತ್ತದೆ.",
  "1ecda0c7d4": "ಕಳ್ಳತನದ ವಿಮೆ",
  "0178de4b00": "ಸ್ಟಾಕ್ ಮಾಲೀಕರು",
  "c4466411ae": "ಕಳ್ಳತನದಿಂದ ಸ್ಟಾಕ್/ನೂಲಿನ ನಷ್ಟವನ್ನು ಆವರಿಸುತ್ತದೆ",
  "9e40d2c0a0": "ಬ್ರೇಕ್-ಇನ್ ಸಮಯದಲ್ಲಿ ಆವರಣಕ್ಕೆ ಹಾನಿ",
  "04d9f58df0": "ಮುಗಿದ ರೇಷ್ಮೆ/ಹತ್ತಿಯ ಕಳ್ಳತನ",
  "9231962665": "ಸಲಕರಣೆ ಕಳ್ಳತನ",
  "6ae68e988f": "ಗಮನಾರ್ಹ ಕಚ್ಚಾ ವಸ್ತು ಅಥವಾ ಸಿದ್ಧಪಡಿಸಿದ ಸ್ಟಾಕ್ ಹೊಂದಿರುವ ನೇಕಾರರಿಗೆ ಶಿಫಾರಸು ಮಾಡಲಾಗಿದೆ.",
  "77400aea04": "ಕಚ್ಚಾ ವಸ್ತುಗಳ ಪೂರೈಕೆ ಯೋಜನೆ",
  "2f6ab504e6": "ಸರ್ಕಾರದ ಯೋಜನೆಯು ನೇಕಾರರಿಗೆ ಸಹಕಾರಿ ಸಂಘಗಳ ಮೂಲಕ ಸಬ್ಸಿಡಿ ದರದಲ್ಲಿ ನೂಲು, ಬಣ್ಣಗಳು ಮತ್ತು ರಾಸಾಯನಿಕಗಳಂತಹ ಉತ್ತಮ ಗುಣಮಟ್ಟದ ಕಚ್ಚಾ ವಸ್ತುಗಳನ್ನು ಪಡೆಯಲು ಅನುವು ಮಾಡಿಕೊಡುತ್ತದೆ.",
  "2b18029087": "30-50% ಸಬ್ಸಿಡಿ ದರದಲ್ಲಿ ಗುಣಮಟ್ಟದ ನೂಲು",
  "be39b99b1a": "ಗಿರಣಿಗಳಿಂದ ನೇಕಾರರಿಗೆ ಸರಬರಾಜು ಸರಪಳಿಯನ್ನು ಆಯೋಜಿಸಲಾಗಿದೆ",
  "2b320a14de": "ಉತ್ಪಾದನಾ ವೆಚ್ಚದಲ್ಲಿ ಕಡಿತ",
  "2838257c98": "ವರ್ಷದುದ್ದಕ್ಕೂ ಖಚಿತವಾದ ವಸ್ತು ಲಭ್ಯತೆ",
  "5fdc4b1bcc": "ನೇಕಾರ ಐಡಿಯೊಂದಿಗೆ ನೋಂದಾಯಿತ ಕೈಮಗ್ಗ ನೇಕಾರ",
  "694cd49a50": "ನೋಂದಾಯಿತ ಕೈಮಗ್ಗ ಸಹಕಾರಿ ಸದಸ್ಯ",
  "124fe5cdd6": "ಬೇರೆ ಇಲಾಖೆಯಿಂದ ಇದೇ ಯೋಜನೆಯನ್ನು ಪಡೆಯುತ್ತಿಲ್ಲ",
  "0aea9e22c2": "ಸಹಕಾರ ಸದಸ್ಯತ್ವದ ಪುರಾವೆ",
  "3b43889f27": "ಬ್ಯಾಂಕ್ ಪಾಸ್ಬುಕ್",
  "a52ecba24e": "ಸಬ್ಸಿಡಿಗಳು",
  "89973762dd": "ಜವಳಿ ಸಚಿವಾಲಯ",
  "15ad4bad4b": "ನೂಲು ಸಹಾಯಧನ ಯೋಜನೆ",
  "83527cab78": "ಕೈಮಗ್ಗ ನೇಕಾರರಿಗೆ ಹತ್ತಿ, ರೇಷ್ಮೆ ಮತ್ತು ಉಣ್ಣೆಯ ನೂಲು ಖರೀದಿಗೆ ನೇರ ನಗದು ಸಬ್ಸಿಡಿ, ಇನ್ಪುಟ್ ವೆಚ್ಚವನ್ನು ಕಡಿಮೆ ಮಾಡುವುದು ಮತ್ತು ಸಾಂಪ್ರದಾಯಿಕ ಜವಳಿ ಉತ್ಪಾದನೆಯನ್ನು ಬೆಂಬಲಿಸುವುದು.",
  "893909fdd3": "ವಾರ್ಷಿಕ ₹4,000–₹12,000 ನೇರ ಲಾಭ ವರ್ಗಾವಣೆ",
  "0acd6c55fc": "ಹತ್ತಿ, ರೇಷ್ಮೆ, ಮತ್ತು ಉಣ್ಣೆಯ ನೂಲು ಆವರಿಸುತ್ತದೆ",
  "a36c494b58": "ಪವರ್ ಲೂಮ್ ಮತ್ತು ಹ್ಯಾಂಡ್ಲೂಮ್ ಎರಡಕ್ಕೂ ಅನ್ವಯಿಸುತ್ತದೆ",
  "aefd9ad366": "ಸಣ್ಣ ನೇಕಾರರಿಗೆ ಪ್ರಮಾಣದಲ್ಲಿ ಹೆಚ್ಚಿನ ಮಿತಿಯಿಲ್ಲ",
  "1599ae9b3b": "ರಾಜ್ಯ ಸರ್ಕಾರ ನೀಡಿದ ಮಾನ್ಯ ನೇಕಾರ ಗುರುತಿನ ಚೀಟಿ",
  "f2400b302d": "ವಾರ್ಷಿಕ ಆದಾಯ ₹1.5 ಲಕ್ಷಕ್ಕಿಂತ ಕಡಿಮೆ",
  "a72eabb3a0": "ನಿಯಮಿತ ಸರ್ಕಾರಿ ಸೇವೆಯಲ್ಲಿ ಉದ್ಯೋಗಿಯಾಗಿಲ್ಲ",
  "6d8a7f0571": "ಆದಾಯ ಪ್ರಮಾಣಪತ್ರ",
  "0e67989f1b": "ಬ್ಯಾಂಕ್ ಖಾತೆ ವಿವರಗಳು",
  "6e65424869": "ಸೌರ ಮಗ್ಗ ಯೋಜನೆ",
  "d7543a5614": "ನೇಕಾರರಿಗೆ ವಿದ್ಯುತ್ ಅವಲಂಬನೆಯನ್ನು ಕಡಿಮೆ ಮಾಡಲು, ಸಮರ್ಥನೀಯ ಉತ್ಪಾದನೆಯನ್ನು ಬೆಂಬಲಿಸಲು ಮತ್ತು ಕಾರ್ಯಾಚರಣೆಯ ವೆಚ್ಚವನ್ನು 60% ವರೆಗೆ ಕಡಿಮೆ ಮಾಡಲು ಸೌರ-ಚಾಲಿತ ಮಗ್ಗ ವ್ಯವಸ್ಥೆಯನ್ನು ಒದಗಿಸುತ್ತದೆ.",
  "4e4cbdae7f": "ಸೋಲಾರ್ ಮಗ್ಗ ಅಳವಡಿಕೆಗೆ ಶೇ.90 ಸಬ್ಸಿಡಿ",
  "e840ff121f": "60% ವಿದ್ಯುತ್ ವೆಚ್ಚ ಕಡಿತ",
  "dd891bf7bf": "ಉತ್ಪನ್ನಗಳಿಗೆ ಹಸಿರು ಪ್ರಮಾಣೀಕರಣ",
  "0c8922b229": "ಸರ್ಕಾರಿ ಖರೀದಿ ಆದೇಶಗಳಲ್ಲಿ ಆದ್ಯತೆ",
  "759c863dfd": "ಕನಿಷ್ಠ 3 ವರ್ಷಗಳ ಅನುಭವದೊಂದಿಗೆ ನೋಂದಾಯಿತ ನೇಕಾರ",
  "5be5efb71d": "ಸ್ವಂತ ಅಥವಾ ಗುತ್ತಿಗೆ ನೇಯ್ಗೆ ಜಾಗ",
  "8ea1a7178a": "ಈ ಹಿಂದೆ ಸೋಲಾರ್ ಉಪಕರಣಗಳ ಅನುದಾನ ಬಂದಿಲ್ಲ",
  "4bff82a5f2": "ನೇಯ್ಗೆ ಜಾಗದ ಮಾಲೀಕತ್ವ/ಗುತ್ತಿಗೆಯ ಪುರಾವೆ",
  "ab2430633e": "ಪಾಸ್ಪೋರ್ಟ್ ಭಾವಚಿತ್ರ",
  "0d08974539": "ಹೊಸ ಮತ್ತು ನವೀಕರಿಸಬಹುದಾದ ಇಂಧನ ಸಚಿವಾಲಯ",
  "0b887c236c": "ರಾಷ್ಟ್ರೀಯ ಕೈಮಗ್ಗ ಅಭಿವೃದ್ಧಿ ಕಾರ್ಯಕ್ರಮ",
  "58ce32e9b9": "ಮೂಲಸೌಕರ್ಯ, ಕೌಶಲ್ಯ ತರಬೇತಿ, ವಿನ್ಯಾಸ ಅಭಿವೃದ್ಧಿ ಮತ್ತು ಮಾರುಕಟ್ಟೆ ಪ್ರವೇಶ ಸೇರಿದಂತೆ ಕೈಮಗ್ಗ ಕ್ಷೇತ್ರದ ಸಮಗ್ರ ಅಭಿವೃದ್ಧಿಗಾಗಿ ಪ್ರಮುಖ ಸರ್ಕಾರಿ ಕಾರ್ಯಕ್ರಮ.",
  "acd0638491": "ನೇಯ್ಗೆ ಕ್ಲಸ್ಟರ್‌ಗಳಿಗೆ ಮೂಲಸೌಕರ್ಯ ಬೆಂಬಲ",
  "6aeaf581a0": "ವಿನ್ಯಾಸ ಅಭಿವೃದ್ಧಿ ಮತ್ತು ತರಬೇತಿ ಸ್ಟೈಫಂಡ್",
  "6bf3a2ca19": "ರಾಷ್ಟ್ರೀಯ ಮತ್ತು ಅಂತರಾಷ್ಟ್ರೀಯ ಮೇಳಗಳಲ್ಲಿ ಮಾರುಕಟ್ಟೆ ಮಾನ್ಯತೆ",
  "4adf4c6f13": "ಬ್ರಾಂಡ್ ಕಟ್ಟಡ ಮತ್ತು ಉತ್ಪನ್ನ ಪ್ರಮಾಣೀಕರಣ",
  "8d39d2a7ad": "ವೈಯಕ್ತಿಕ ನೇಕಾರ ಅಥವಾ ನೇಕಾರ ಗುಂಪು",
  "b10b3d4ceb": "ಗೊತ್ತುಪಡಿಸಿದ ಕೈಮಗ್ಗ ಕ್ಲಸ್ಟರ್‌ನಲ್ಲಿದೆ",
  "1a9a6d8868": "ಜಿಲ್ಲಾ ಕೈಮಗ್ಗ ಕಚೇರಿಯಲ್ಲಿ ಮಾನ್ಯ ನೋಂದಣಿ",
  "7d963a7c3f": "ಜಿಲ್ಲಾ ಕೈಮಗ್ಗ ಕಚೇರಿಯಿಂದ ನೋಂದಣಿ ಪ್ರಮಾಣಪತ್ರ",
  "875ec24cf2": "ಕ್ಲಸ್ಟರ್ ಐಡಿ ಪುರಾವೆ",
  "f1b3e6404a": "ಬ್ಯಾಂಕ್ ವಿವರಗಳು",
  "cf270e40d2": "ತರಬೇತಿ",
  "e9cbaede0a": "ಕೈಮಗ್ಗ ನೇಕಾರರಿಗೆ ಕೌಶಲ್ಯ ಅಭಿವೃದ್ಧಿ ಯೋಜನೆ",
  "2b692b685b": "ನೇಕಾರರ ಸೇವಾ ಕೇಂದ್ರಗಳ ಅಡಿಯಲ್ಲಿ ನೇಯ್ಗೆ ಕೌಶಲ್ಯಗಳನ್ನು ನವೀಕರಿಸಲು ತರಬೇತಿ ಕಾರ್ಯಕ್ರಮ, ಹೊಸ ವಿನ್ಯಾಸಗಳು, ಆಧುನಿಕ ತಂತ್ರಗಳು ಮತ್ತು ದೇಶೀಯ ಮತ್ತು ರಫ್ತು ಮಾರುಕಟ್ಟೆಗಳಿಗೆ ಗುಣಮಟ್ಟದ ಮಾನದಂಡಗಳನ್ನು ಪರಿಚಯಿಸುವುದು.",
  "b8b9e2b350": "ಉಚಿತ 3-6 ತಿಂಗಳ ತರಬೇತಿ ಕಾರ್ಯಕ್ರಮ",
