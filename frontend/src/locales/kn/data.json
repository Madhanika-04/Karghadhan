  "6ca1e65cba": "ಅಪಘಾತ ಚಿಕಿತ್ಸೆಗಳು",
  "74a437a63f": "ಆಸ್ಪತ್ರೆಯ ವೆಚ್ಚದಿಂದ ಕುಟುಂಬವನ್ನು ರಕ್ಷಿಸುತ್ತದೆ.",
  "81338a4c60": "ವೈಯಕ್ತಿಕ ಅಪಘಾತ ವಿಮೆ",
  "386b25de7a": "ಪ್ರತಿಯೊಬ್ಬ ಸಕ್ರಿಯ ನೇಕಾರ",
  "0f115b52eb": "ಆಕಸ್ಮಿಕ ಮರಣಕ್ಕೆ ಕವರೇಜ್",
  "dadc431167": "ಶಾಶ್ವತ/ಭಾಗಶಃ ಅಂಗವೈಕಲ್ಯ ರಕ್ಷಣೆ",
  "f9eab08347": "ಆದಾಯ ಬದಲಿ",
  "4de8fa938d": "ಕೆಲಸದ ಸ್ಥಳದಲ್ಲಿ ಅಪಘಾತಗಳು",
  "5bf91ffbd3": "ರಸ್ತೆ ಅಪಘಾತಗಳು",
  "9ab15f2b55": "ಸಕ್ರಿಯ ನೇಕಾರರಿಗೆ ಅಗತ್ಯವಾದ ಅಪಘಾತ ರಕ್ಷಣೆ.",
  "817078f804": "ಸಾಲ ರಕ್ಷಣೆ ವಿಮೆ",
